    "version": "0.2.0",
    "configurations": [
        {
            "name": "Deb: test_result",
            "type": "debugpy",
            "request": "launch",
            "program": "-m",
            "args": [
                "unittest",
                "test.test_result.TestResultSystem",
                "-v"
            ],
            "console": "integratedTerminal",
            "justMyCode": false,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/src"            
            }
        },
    ]
}